<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_multi_order_return" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.multi.order.return</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app name="partner_multi_order_return" string="Multi Order Returns" data-string="Multi Order Returns" groups="stock.group_stock_user">
          <block title="Return Processing" name="multi_order_return_settings">
            <setting string="Return Allocation Method" help="Choose how historical delivery quantities are allocated to a return.">
              <field name="return_allocation_method"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
